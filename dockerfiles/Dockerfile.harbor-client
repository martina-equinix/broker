# ──────────────────────────────────────────────────────────────────────────────
# Snyk Broker Classic Client — Harbor proxy for Backstage (v4.147.0)
#
# This image runs the broker in "client" mode.  It sits next to Backstage,
# dials out to the broker server, and forwards approved Harbor API requests.
#
# Required environment variables at runtime:
#   BROKER_TOKEN        – Shared UUIDv4 secret (must match the server)
#   BROKER_SERVER_URL   – URL of the broker server,
#                         e.g. http://broker-harbor-server:8000
#   BROKER_CLIENT_URL   – Public/reachable URL of THIS client (for callbacks),
#                         e.g. http://broker-harbor-client:8001
#   HARBOR_URL          – Full base URL of Harbor,
#                         e.g. https://harbor.delivery.metalkube.net
#   PORT                – Port this client listens on (default: 8001)
# ──────────────────────────────────────────────────────────────────────────────

FROM node:20.19-trixie-slim

ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=$PATH:/home/node/.npm-global/bin

# ── runtime defaults ──────────────────────────────────────────────────────────
ENV PORT=8001 \
    BROKER_TYPE=harbor \
    HARBOR_URL=https://harbor.delivery.metalkube.net

USER root

# Install the older working version of snyk-broker
RUN npm install --global snyk-broker@4.147.0

# removing non-used (transitive) dependencies to fix vulnerabilities
RUN rm -rf /home/node/.npm-global/lib/node_modules/snyk-broker/node_modules/setheader/node_modules/debug

WORKDIR /home/node

# ── broker accept rules and clean config ────────────────────────────────────
COPY accept.harbor-client.json /home/node/accept.harbor-client.json
COPY config.default.json /home/node/config.default.json

# Symlink config.default.json to the broker installation directory
RUN ln -sf /home/node/config.default.json /home/node/.npm-global/lib/node_modules/snyk-broker/config.default.json

# ── fix permissions for arbitrary UIDs (OpenShift / restricted PSPs) ──────────
RUN chgrp -R 0 /home/node && \
    chmod -R g=u,o= /home/node && \
    chown -R node /home/node

USER node

EXPOSE ${PORT}

# Run as broker CLIENT.
# ACCEPT controls which paths Backstage is allowed to request through this client.
CMD ["npx", "broker", "client", "--verbose"]

