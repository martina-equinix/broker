# ── Harbor connection (used by the SERVER) ────────────────────────────────────
HARBOR_URL=https://harbor.delivery.metalkube.net
HARBOR_USERNAME=robot$your-robot-account
HARBOR_PASSWORD=your-robot-account-secret

# ── Shared secret between client and server (must be a UUIDv4) ───────────────
# Generate a fresh one with: uuidgen | tr '[:upper:]' '[:lower:]'
BROKER_TOKEN=00000000-0000-0000-0000-000000000000

# ── Server settings ───────────────────────────────────────────────────────────
SERVER_PORT=8000

# ── Client settings ───────────────────────────────────────────────────────────
CLIENT_PORT=8001

# URL the CLIENT uses to reach the SERVER
# When running via docker compose on the same host, use the service name.
# Change to a real hostname/IP when the server is on a different host.
BROKER_SERVER_URL=http://broker-harbor-server:8000

# URL the SERVER (and Backstage) uses to reach back to the CLIENT
# Change to a real hostname/IP when the client is on a different host.
BROKER_CLIENT_URL=http://broker-harbor-client:8001
