# ── Shared server ────────────────────────────────────────────────────────────
SERVER_PORT=7341

# ── Harbor client ─────────────────────────────────────────────────────────────
HARBOR_URL=https://harbor.delivery.metalkube.net

# Broker token for the Harbor client (UUIDv4 — must match what Backstage uses)
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
HARBOR_BROKER_TOKEN=00000000-0000-0000-0000-000000000001

CLIENT_PORT=8001

# URL the SERVER (and Backstage) uses to reach back to the Harbor client
BROKER_CLIENT_URL=http://broker-harbor-client:8001

# ── ArgoCD client ─────────────────────────────────────────────────────────────
ARGOCD_URL=https://argo.delivery.metalkube.net

# Broker token for the ArgoCD client (UUIDv4 — must be different from Harbor's)
ARGOCD_BROKER_TOKEN=00000000-0000-0000-0000-000000000002

ARGOCD_CLIENT_PORT=8002

# URL the SERVER (and Backstage) uses to reach back to the ArgoCD client
ARGOCD_BROKER_CLIENT_URL=http://broker-argocd-client:8002

