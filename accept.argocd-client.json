{
  "public": [
    {
      "method": "GET",
      "path": "/healthcheck"
    },
    {
      "method": "GET",
      "path": "/systemcheck"
    }
  ],
  "private": [
    {
      "method": "any",
      "path": "/(.*)",
      "origin": "${BACKEND_URL}",
      "auth": {
        "scheme": "bearer",
        "token": "${ARGOCD_TOKEN}"
      }
    }
  ]
}

